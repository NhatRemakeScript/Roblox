local function hideName()
	pcall(function()
		local rn=LP.Name
		local function sc(c)
			for _,o in ipairs(c:GetDescendants()) do
				if o:IsA("TextLabel") and (o.Text==rn or o.Text=="@"..rn) then
					if not fnC[o] then fnC[o]={t=o.Text,v=o.Visible,tr=o.TextTransparency} end
					o.Text="" o.Visible=false o.TextTransparency=1
				end
			end
		end
		sc(workspace)
		for _,g in ipairs(PG:GetChildren()) do if g:IsA("ScreenGui") then sc(g) end end
	end)
end

local function restoreName()
	for o,d in pairs(fnC) do
		pcall(function()
			if o and o.Parent then o.Text=d.t o.Visible=d.v o.TextTransparency=d.tr end
		end)
	end
	fnC={}
end

