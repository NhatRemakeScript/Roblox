local function findIsland(n)
	local t="island_"..n
	for _,o in ipairs(workspace:GetDescendants()) do if string.lower(o.Name)==t then return o end end
end

local function findSpawn(i)
	if not i then return nil end
	for _,d in ipairs(i:GetDescendants()) do if d:IsA("SpawnLocation") then return d end end
	for _,d in ipairs(i:GetDescendants()) do if d:IsA("BasePart") and string.find(string.lower(d.Name),"spawn") then return d end end
	if i:IsA("Model") and i.PrimaryPart then return i.PrimaryPart end
	for _,d in ipairs(i:GetChildren()) do if d:IsA("BasePart") then return d end end
end

local function teleIsland(n)
	local i=findIsland(n)
	if not i then WindUI:Notify({Title="Tele",Content="Không tìm thấy island_"..n,Duration=3}) return end
	local sp2=findSpawn(i)
	if not sp2 then WindUI:Notify({Title="Tele",Content="Không có spawn",Duration=3}) return end
	tweenTo(CFrame.new(sp2.Position+Vector3.new(0,5,0)))
	task.wait(0.3)
	eqRod()
	task.wait(0.2)
	WindUI:Notify({Title="Tele",Content="Đã tới "..n,Duration=2})
end

local espF,espC
local function clearESP()
	if espF then pcall(function() espF:Destroy() end) espF=nil end
	if espC then pcall(function() espC:Disconnect() end) espC=nil end
end

local function startESP()
	clearESP()
	espF=Instance.new("Folder")
	espF.Name="DNHub_ESP"
	espF.Parent=workspace
	for _,name in ipairs(IL) do
		local isl=findIsland(name)
		if isl then
			local part=findSpawn(isl)
			if part then
				local box=Instance.new("BoxHandleAdornment")
				box.Size=Vector3.new(20,20,20)
				box.Adornee=part
				box.AlwaysOnTop=true
				box.ZIndex=5
				box.Transparency=0.5
				box.Color3=Color3.fromRGB(0,255,200)
				box.Parent=espF
				local lb=Instance.new("BillboardGui")
				lb.Size=UDim2.new(0,200,0,30)
				lb.StudsOffset=Vector3.new(0,15,0)
				lb.AlwaysOnTop=true
				lb.Adornee=part
				lb.Parent=espF
				local tx=Instance.new("TextLabel")
				tx.Size=UDim2.new(1,0,1,0)
				tx.BackgroundTransparency=1
				tx.Text=isl.Name
				tx.TextColor3=Color3.fromRGB(0,255,200)
				tx.TextStrokeTransparency=0
				tx.TextSize=14
				tx.Font=Enum.Font.GothamBold
				tx.Parent=lb
			end
		end
	end
	espC=Run.Heartbeat:Connect(function()
		if not st.esp then return end
		for _,b in ipairs(espF:GetChildren()) do
			if b:IsA("BoxHandleAdornment") and not b.Adornee then b:Destroy() end
		end
	end)
end

local function stopESP() clearESP() end

