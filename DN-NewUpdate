local function sState()
	local c=LP.Character
	if not c then return nil end
	local h=c:FindFirstChild("HumanoidRootPart")
	local hu=c:FindFirstChildOfClass("Humanoid")
	if not h or not hu then return nil end
	local s={cframe=h.CFrame,vel=h.AssemblyLinearVelocity,ang=h.AssemblyAngularVelocity,rv=h.RotVelocity,ar=hu.AutoRotate,ps=hu.PlatformStand,ws=hu.WalkSpeed,jp=hu.JumpPower,hs=hu:GetState(),cc={}}
	for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then s.cc[p]=p.CanCollide end end
	return s
end

local function rState(s)
	if not s then return end
	local c=LP.Character
	if not c then return end
	local h=c:FindFirstChild("HumanoidRootPart")
	local hu=c:FindFirstChildOfClass("Humanoid")
	if not h or not hu then return end
	h.CFrame=s.cframe
	h.AssemblyLinearVelocity=s.vel
	h.AssemblyAngularVelocity=s.ang
	h.RotVelocity=s.rv
	hu.AutoRotate=s.ar
	hu.PlatformStand=s.ps
	hu.WalkSpeed=s.ws
	hu.JumpPower=s.jp
	pcall(function() hu:ChangeState(s.hs) end)
	for p,cc in pairs(s.cc) do if p and p.Parent then p.CanCollide=cc end end
end

local function tSpeed() return teleMode=="fast" and 100 or 40 end

local function tweenTo(cf, spd)
	spd=spd or tSpeed()
	pcall(function()
		local c=LP.Character
		if not c then return end
		local h=c:FindFirstChild("HumanoidRootPart")
		local hu=c:FindFirstChildOfClass("Humanoid")
		if not h or not hu then return end
		local sv=sState()
		hu.AutoRotate=false
		hu.PlatformStand=true
		hu:ChangeState(Enum.HumanoidStateType.Physics)
		local sCF=h.CFrame
		local sR=sCF-sCF.Position
		local sP=sCF.Position
		local tP=cf.Position
		local d=(tP-sP).Magnitude
		if d<1 then
			h.CFrame=CFrame.new(tP)*sR
			if sv then sv.cframe=CFrame.new(tP)*sR sv.vel=Vector3.zero sv.ang=Vector3.zero sv.rv=Vector3.zero end
			rState(sv)
			return
		end
		local nc
		nc=Run.Stepped:Connect(function()
			if c then for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end end
		end)
		local dur=d/spd
		local stk=tick()
		while tick()-stk<dur do
			local c2=LP.Character
			if not c2 then break end
			local h2=c2:FindFirstChild("HumanoidRootPart")
			if not h2 then break end
			local a=math.clamp((tick()-stk)/dur,0,1)
			h2.CFrame=CFrame.new(sP:Lerp(tP,a))*sR
			h2.AssemblyLinearVelocity=Vector3.zero
			h2.AssemblyAngularVelocity=Vector3.zero
			h2.RotVelocity=Vector3.zero
			task.wait(0.03)
		end
		if nc then nc:Disconnect() end
		local c3=LP.Character
		if c3 then local h3=c3:FindFirstChild("HumanoidRootPart") if h3 then h3.CFrame=CFrame.new(tP)*sR end end
		if sv then sv.cframe=CFrame.new(tP)*sR sv.vel=Vector3.zero sv.ang=Vector3.zero sv.rv=Vector3.zero end
		rState(sv)
	end)
end

local function eqRod()
