local function findNPC()
	local c=LP.Character
	if not c or not c:FindFirstChild("HumanoidRootPart") then return nil end
	local mp=c.HumanoidRootPart.Position
	local best,bd=nil,math.huge
	for _,o in ipairs(workspace:GetDescendants()) do
		local n=string.lower(o.Name)
		if string.find(n,"seller") or string.find(n,"fish_seller") or string.find(n,"fishseller") then
			local p
			if o:IsA("Model") then p=o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
			elseif o:IsA("BasePart") then p=o end
			if p then
				local d=(mp-p.Position).Magnitude
				if d<bd then bd=d best=p end
			end
		end
	end
	return best
end

local function doSell()
	local wf=st.fish
	if wf then st.fish=false rmPlat() task.wait(0.3) end
	local c=LP.Character
	if not c or not c:FindFirstChild("HumanoidRootPart") then
		if wf then st.fish=true startFish() end
		return false
	end
	local oldCF=c.HumanoidRootPart.CFrame
	local npc=findNPC()
	if not npc then
		WindUI:Notify({Title="Sell",Content="Không tìm thấy NPC",Duration=3})
		if wf then st.fish=true startFish() end
		return false
	end
	tweenTo(CFrame.new(npc.Position+Vector3.new(0,3,5)),40)
	task.wait(0.5)
	local synced,cnt=false,0
	local pkt=RS:FindFirstChild("Stardust") and RS.Stardust:FindFirstChild("Packages") and RS.Stardust.Packages:FindFirstChild("Packet") and RS.Stardust.Packages.Packet:FindFirstChild("RemoteEvent")
	if pkt and getrawmetatable and setreadonly and newcclosure then
		pcall(function()
			local mt=getrawmetatable(pkt)
			if not mt then return end
			local old=mt.__namecall
			setreadonly(mt,false)
			mt.__namecall=newcclosure(function(self,...)
				if self==pkt and getnamecallmethod()=="FireServer" then
					for _,v in ipairs({...}) do
						if typeof(v)=="buffer" and buffer.len(v)>=2 then cnt=buffer.readu8(v,1) synced=true end
					end
				end
				return old(self,...)
			end)
			setreadonly(mt,true)
		end)
		local t0=tick()
		while not synced and tick()-t0<5 do task.wait(0.05) end
	end
	if not synced then
		cnt=math.random(0,255)
	end
	local function sp(op,pl)
		cnt=(cnt+1)%256
		if type(buffer)=="table" then
			local b=buffer.create(2+(pl and #pl or 0))
			buffer.writeu8(b,0,string.byte(op))
			buffer.writeu8(b,1,cnt)
			if pl then for i=1,#pl do buffer.writeu8(b,1+i,pl[i]) end end
			pcall(function() pkt:FireServer(b) end)
		else
			local s=string.char(string.byte(op),cnt)
			if pl then for i=1,#pl do s=s..string.char(pl[i]) end end
			pcall(function() pkt:FireServer(s) end)
		end
	end
	WindUI:Notify({Title="Sell",Content="Đang bán cá",Duration=2})
	sp("c",{0x41}) task.wait(0.2)
	sp("c",{0x42,0x01}) task.wait(0.2)
	sp("c",{0x43}) task.wait(0.2)
	sp("f",{0x4A}) task.wait(0.2)
	sp("c",{0x4B}) task.wait(0.2)
	sp("\\",{0x4C}) task.wait(0.2)
	sp("c",{0x4D,0x01}) task.wait(0.2)
	sp("c",{0x4E}) task.wait(0.5)
	WindUI:Notify({Title="Sell",Content="Đang quay về...",Duration=2})
	tweenTo(oldCF,40)
	task.wait(0.3)
	eqRod()
	task.wait(0.2)
	if wf then st.fish=true startFish() end
	WindUI:Notify({Title="Sell",Content="Bán xong!",Duration=3})
	return true
end

